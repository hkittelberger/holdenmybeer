{
  "name": "spotify-listening-logger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Polls Spotify's recently-played endpoint on a schedule and appends new plays to a Postgres (Neon) database.",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && node --env-file=.env dist/index.js",
    "import:history": "node --experimental-strip-types --env-file=.env scripts/import-history.ts",
    "metadata:resolve": "node --experimental-strip-types --env-file=.env scripts/resolve-metadata.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
